---
const year = new Date().getFullYear();
---

<footer class="bg-sumi-900 text-washi-200 py-16 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04] pointer-events-none">
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full bg-matcha-300 blur-[120px]"
    >
    </div>
  </div>
  <div class="relative max-w-5xl mx-auto px-6 text-center">
    <p class="font-serif text-3xl mb-3">齊藤</p>
    <p class="text-[10px] text-washi-200/50 tracking-[0.4em] mb-10">
      ─── お茶と暮らす ───
    </p>
    <div class="w-8 h-px bg-washi-200/30 mx-auto mb-10"></div>
    <p class="text-[11px] text-washi-200/50 tracking-widest">
      © {year} Saito · All rights reserved.
    </p>
  </div>
</footer>
