---
const links = [
  {
    label: "Email",
    href: "mailto:example@example.com",
    value: "example@example.com",
    icon: "email",
  },
  {
    label: "X (Twitter)",
    href: "https://twitter.com/",
    value: "@saitousan",
    icon: "x",
  },
  {
    label: "Instagram",
    href: "https://instagram.com/",
    value: "@saitousan",
    icon: "instagram",
  },
  { label: "note", href: "https://note.com/", value: "saitousan", icon: "note" },
];
---

<section
  id="contact"
  class="pt-28 pb-20 md:pt-32 md:pb-24 bg-washi-50 theme-bg-washi-50 relative overflow-hidden"
>
  <div class="absolute inset-0 opacity-30 pointer-events-none">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[600px] rounded-full bg-matcha-200 blur-[120px]"
    >
    </div>
  </div>
  <div class="relative max-w-3xl mx-auto px-6 text-center">
    <p
      class="label-dot font-serif text-matcha-600 theme-text-matcha-600 tracking-[0.4em] mb-3 text-xs reveal"
    >
      CONTACT
    </p>
    <h2
      class="font-serif text-3xl md:text-5xl text-sumi-900 mt-6 mb-8 reveal reveal-delay-1 leading-tight"
    >
      お茶でも一緒に、<br class="md:hidden" />いかがですか
    </h2>
    <p
      class="text-sumi-700 leading-loose mb-14 max-w-lg mx-auto reveal reveal-delay-2"
    >
      お茶会のお誘い、企画のご相談、お問い合わせなど。<br
      />湯気のたつ一杯のように、気軽にお声かけください。
    </p>

    <ul
      class="grid sm:grid-cols-2 gap-3 max-w-xl mx-auto reveal reveal-delay-3 mb-16"
    >
      {
        links.map((link) => {
          const ext = link.href.startsWith("http");
          return (
            <li>
              <a
                href={link.href}
                target={ext ? "_blank" : undefined}
                rel={ext ? "noopener noreferrer" : undefined}
                class="group flex items-center gap-4 px-5 py-4 border border-washi-200 hover:border-matcha-700 theme-border-matcha-700 bg-washi-100/40 hover:bg-washi-100/80 transition-all text-left"
              >
                <span class="shrink-0 w-10 h-10 flex items-center justify-center rounded-full border border-matcha-300/50 group-hover:border-matcha-700 theme-border-matcha-700 text-matcha-600 theme-text-matcha-600 group-hover:text-matcha-700 transition-colors">
                  {link.icon === "email" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="5" width="18" height="14" rx="2" />
                      <path d="M3 7l9 6 9-6" />
                    </svg>
                  )}
                  {link.icon === "x" && (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                    >
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  )}
                  {link.icon === "instagram" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <rect x="3" y="3" width="18" height="18" rx="5" />
                      <circle cx="12" cy="12" r="4" />
                      <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
                    </svg>
                  )}
                  {link.icon === "note" && (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4 20l4-1 11-11-3-3L5 16z" />
                      <path d="M14 5l3 3" />
                    </svg>
                  )}
                </span>
                <span class="flex-1 min-w-0">
                  <span class="block text-[10px] text-matcha-700 theme-text-matcha-700 font-serif tracking-[0.3em] mb-1">
                    {link.label}
                  </span>
                  <span class="block text-sm text-sumi-800 truncate">{link.value}</span>
                </span>
                <span
                  class="shrink-0 opacity-0 group-hover:opacity-100 transition-opacity text-matcha-700 theme-text-matcha-700"
                >
                  →
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="reveal">
      <div class="w-px h-10 bg-matcha-400/40 mx-auto mb-6"></div>
      <p
        class="font-serif text-matcha-700 theme-text-matcha-700 italic text-sm md:text-base tracking-wide"
      >
        ── お返事は、お茶を一杯淹れたあとに ──
      </p>
    </div>
  </div>
</section>
