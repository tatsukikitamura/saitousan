---
const base = import.meta.env.BASE_URL;
const link = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;
---

<section
  id="top"
  class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-b from-washi-50 via-washi-100 to-matcha-50 theme-bg-matcha-50 pt-24 pb-20 md:pt-20 md:pb-0"
>
  <div class="absolute inset-0 opacity-30 pointer-events-none">
    <div
      class="absolute top-[10%] left-[15%] w-[300px] h-[300px] md:w-[420px] md:h-[420px] rounded-full bg-matcha-200 blur-[120px]"
    >
    </div>
    <div
      class="absolute bottom-[10%] right-[15%] w-[320px] h-[320px] md:w-[480px] md:h-[480px] rounded-full bg-sencha-500/40 blur-[140px]"
    >
    </div>
  </div>

  <div
    class="absolute inset-y-0 right-0 w-[45%] hidden md:block"
  >
    <div class="absolute inset-6 overflow-hidden">
      <img
        src={link("/saito.jpg")}
        alt="茶室で点前をする名前(仮)"
        class="w-full h-full object-cover opacity-90"
      />
      <div
        class="absolute inset-0 bg-gradient-to-l from-transparent to-washi-50/40"
      >
      </div>
    </div>
  </div>

  <div
    class="relative w-full max-w-6xl mx-auto px-6 md:px-12 grid md:grid-cols-2 gap-12 items-center"
  >
    <div>
      <p
        class="font-serif text-matcha-600 theme-text-matcha-600 tracking-[0.4em] mb-6 md:mb-10 text-[10px] md:text-xs"
      >
        ─── お茶と暮らす ───
      </p>

      <div class="mb-8 md:mb-12">
        <h1
          class="font-serif text-7xl md:text-7xl text-sumi-900 leading-[1.1] tracking-[0.1em] md:tracking-[0.15em] mb-4"
        >
          名前(仮)
        </h1>
        <p
          class="font-serif text-xs md:text-sm text-matcha-700 theme-text-matcha-700 tracking-[0.3em]"
        >
          SAITO
        </p>
        <div class="w-8 h-px bg-matcha-400 my-3"></div>
        <p class="text-[11px] md:text-xs text-sumi-600 font-serif tracking-widest">
          鉄馬を駆り、茶を愛す
        </p>
      </div>

      <p
        class="font-serif text-xl md:text-xl text-sumi-800 leading-loose mb-6 md:mb-10"
      >
        昼はエンジンの音、<br />夜は湯のしずかな音。
      </p>
      <p class="text-sm text-sumi-700 leading-loose mb-10 md:mb-12 max-w-md">
        ハーレーを転がすバイク屋として、<br
        />一日の終わりには、急須を握る。<br
        />相反するふたつの時間を、私はどちらも愛しています。
      </p>

      <div class="flex flex-col sm:flex-row gap-3 sm:flex-wrap">
        <a
          href="#story"
          class="group inline-flex items-center justify-center sm:justify-start gap-2 px-6 py-4 sm:px-7 sm:py-3 bg-matcha-700 theme-bg-matcha-700 text-washi-50 hover:bg-matcha-800 transition-colors text-sm tracking-wider"
        >
          お茶を始めた理由
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <a
          href="#about"
          class="inline-flex items-center justify-center sm:justify-start gap-2 px-6 py-4 sm:px-7 sm:py-3 border border-matcha-700/50 theme-border-matcha-700 text-matcha-700 theme-text-matcha-700 hover:bg-matcha-700 hover:text-washi-50 transition-colors text-sm tracking-wider"
        >
          プロフィール
        </a>
      </div>
    </div>
  </div>

</section>
