---
const activities = [
  {
    title: "お茶会",
    en: "Tea Gathering",
    body: "季節に合わせたお茶会を、不定期で開いています。形式ばらない、気軽な集まりです。お茶を初めての方にも、ぜひ。",
    image: "https://images.unsplash.com/photo-1571934811356-5cc061b6821f?w=900&q=80",
  },
  {
    title: "発信",
    en: "Journal",
    body: "お茶にまつわる日々の出来事や、おすすめのお茶葉を、SNSやnoteで綴っています。気の向いたときに覗いてみてください。",
    image: "https://images.unsplash.com/photo-1576092768241-dec231879fc3?w=900&q=80",
  },
  {
    title: "ご相談",
    en: "Collaboration",
    body: "お茶を介したイベント、企画、コラボレーションのご相談を承っています。一緒に何か面白いことができたら、うれしいです。",
    image: "https://images.unsplash.com/photo-1558160074-4d7d8bdf4256?w=900&q=80",
  },
];
---

<section
  id="activities"
  class="pt-32 pb-24 md:pt-40 md:pb-32 bg-washi-50 theme-bg-washi-50"
>
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20 reveal">
      <p
        class="label-dot font-serif text-matcha-600 theme-text-matcha-600 tracking-[0.4em] mb-3 text-xs"
      >
        ACTIVITIES
      </p>
      <h2 class="font-serif text-3xl md:text-5xl text-sumi-900 mt-6 mb-6">
        活動について
      </h2>
      <p class="text-sumi-700 max-w-xl mx-auto leading-loose">
        お茶を真ん中に、ゆるやかに広がっていく時間。<br
        />そんな営みを、いくつかご紹介します。
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-10 reveal">
      {
        activities.map((a, i) => (
          <article class="group">
            <div class="aspect-[4/5] bg-matcha-100 overflow-hidden mb-6">
              <img
                src={a.image}
                alt={a.title}
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-[1500ms] group-hover:scale-105"
              />
            </div>
            <p class="font-serif text-matcha-600 theme-text-matcha-600 text-xs tracking-[0.3em] mb-2">
              0{i + 1} · {a.en}
            </p>
            <h3 class="font-serif text-2xl text-sumi-900 mb-4">{a.title}</h3>
            <p class="text-sm text-sumi-700 leading-loose">{a.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
